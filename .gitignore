# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the build-time configuration the
# commercial routing interface needs and contains no secret.
!.env.example

# database isolation cutover
# Connection strings for both projects, passwords included. The `.env*` rule
# above does not catch this one — it matches names that START with .env, and
# this ends with it.
/scripts/isolation/cutover.env
# export-from-tancerca.sh writes every lead, every contact and every specialist
# here as plain SQL — real names, addresses and phone numbers. It is a migration
# artefact with a lifetime of one cutover, not a file that belongs in history.
/scripts/isolation/out/

# supabase CLI local state (holds the linked project ref and pooler URL)
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
